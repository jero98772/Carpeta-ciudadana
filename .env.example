# Copia este archivo como .env (o ejecuta: python scripts/generar_secretos.py)
# Lo leen tanto docker compose como el modo local (python -m micarpeta.local).

# --- Secretos: cámbialos. generar_secretos.py pone valores aleatorios.
TOKEN_INTERNO=cambiar-token-interno
SECRETO_URLS=cambiar-secreto-urls
CLAVE_SELLO=cambiar-clave-sello
ADMIN_API_KEY=cambiar-admin
# base64 de 32 bytes para AES-256-GCM (vacío = clave derivada de desarrollo)
CLAVE_CIFRADO_CUSTODIA=

# --- GovCarpeta real. Déjalo comentado para usar el simulador.
# 1) python scripts/registrar_operador.py --direccion ... --correo ... --participantes ...
# 2) pega aquí el id que imprime y descomenta ambas líneas
# GOVCARPETA_URL=https://govcarpeta-apis-4905ff3c005b.herokuapp.com
# GOVCARPETA_OPERATOR_ID=

# --- Opcionales
# NOMBRE_OPERADOR=MiCarpeta CO
# ANTIVIRUS=clamav            # requiere: docker compose --profile antivirus up
# URL_PUBLICA_CUSTODIA=https://descargas.tu-dominio.co
